# Runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Used for cost estimates when the worker cannot auto-detect a rate
RUNPOD_GPU_TYPE=L40S
RUNPOD_GPU_RATE_PER_SEC=0.00053

# MiniMax hosted API baseline for savings %
MINIMAX_RATE_PER_SEC=0.13

# Hugging Face (gated/public download + Runpod model cache auth)
HF_TOKEN=

# H3 runtime
H3_MODEL_ID=MiniMaxAI/MiniMax-H3
# auto | a100_bf16_offload | int8_group_offload
H3_MEMORY_MODE=auto
H3_NUM_INFERENCE_STEPS=20
H3_DEFAULT_PRESET=draft
# 0 = load on first job (recommended). 1 = background warm after queue register.
H3_EAGER_LOAD=0
# Prefer a Runpod network volume mount at /runpod-volume for HF weights.
# HF_HOME=/runpod-volume/huggingface-cache
# Optional: absolute path override (Runpod cache snapshot, etc.)
# H3_MODEL_PATH=

# Upscale
UPSCALER=ffmpeg
FFMPEG_CRF=16
FFMPEG_PRESET=medium

# Durable output storage (S3-compatible: AWS, R2, B2, MinIO, …)
# If unset, videos are written under OUTPUT_DIR and returned as file:// URLs.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN/base URL. If empty, a presigned URL is returned.
S3_PUBLIC_BASE_URL=
S3_PRESIGN_SECONDS=604800
# S3_ACL=public-read

OUTPUT_DIR=/tmp/h3_outputs

# Airing layer (distribute/) — Postiz carriage
# Prefer upstream Postiz compose; API path is /api/public/v1
DISTRIBUTOR_BASE_URL=
DISTRIBUTOR_API_KEY=
# Force dry-run payloads (no HTTP) even if URL/key are set
DISTRIBUTOR_DRY_RUN=0
# Optional overrides
# DISTRIBUTE_BUILD_DIR=
# DISTRIBUTE_BINDINGS_DIR=
# DISTRIBUTE_MAX_POST_SECONDS=60

# Postiz OAuth (when running distribute/docker-compose.yml profile external-deps)
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# POSTIZ_JWT_SECRET=
# POSTIZ_DATABASE_URL=
# POSTIZ_REDIS_URL=
# POSTIZ_TEMPORAL_ADDRESS=
