# Runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Used for cost estimates when the worker cannot auto-detect a rate
RUNPOD_GPU_TYPE=L40S
RUNPOD_GPU_RATE_PER_SEC=0.00053

# MiniMax hosted API baseline for savings %
MINIMAX_RATE_PER_SEC=0.13

# Hugging Face (gated/public download + Runpod model cache auth)
HF_TOKEN=

# H3 runtime
H3_MODEL_ID=MiniMaxAI/MiniMax-H3
# auto | a100_bf16_offload | int8_group_offload
H3_MEMORY_MODE=auto
H3_NUM_INFERENCE_STEPS=20
H3_DEFAULT_PRESET=native
H3_EAGER_LOAD=1
# Optional: absolute path override (Runpod cache snapshot, etc.)
# H3_MODEL_PATH=

# Upscale
UPSCALER=ffmpeg
FFMPEG_CRF=16
FFMPEG_PRESET=medium

# Durable output storage (S3-compatible: AWS, R2, B2, MinIO, …)
# If unset, videos are written under OUTPUT_DIR and returned as file:// URLs.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN/base URL. If empty, a presigned URL is returned.
S3_PUBLIC_BASE_URL=
S3_PRESIGN_SECONDS=604800
# S3_ACL=public-read

OUTPUT_DIR=/tmp/h3_outputs
